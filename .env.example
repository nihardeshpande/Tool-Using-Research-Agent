# Optional OpenAI-compatible model endpoint for model-directed tool selection.
# Leave RESEARCH_AGENT_MODEL empty to use the built-in extractive planner.
RESEARCH_AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Or use OpenRouter (RESEARCH_AGENT_MODEL should be a provider/model ID).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Tool-Using Research Agent

# Hard maximum number of tool calls in a run (default: 6).
MAX_STEPS=6
SEARCH_RESULTS=5
REQUEST_TIMEOUT=15
